{
  "name": "three-body",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:wasm": "cargo build --release -p sim --target wasm32-unknown-unknown && mkdir -p public && cp target/wasm32-unknown-unknown/release/sim.wasm public/sim.wasm",
    "dev": "npm run build:wasm && astro dev",
    "build": "npm run build:wasm && astro build && node scripts/subset-fonts.mjs",
    "preview": "astro preview",
    "lint": "astro check",
    "test:e2e": "playwright test",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:images": "node scripts/check-image-metadata.mjs",
    "check:budget": "node scripts/check-asset-budget.mjs"
  },
  "dependencies": {
    "@fontsource/stix-two-math": "^5.3.0",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "computer-modern": "^0.1.3",
    "lighthouse": "^13.6.0",
    "subset-font": "^2.9.0",
    "temml": "^0.14.0",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "fsevents": false
  }
}
