---
// 三体問題シミュレーター（docs/plan.md、docs/ui-redesign.md）。説明は help/ に置き、ここには操作と図と数値だけを置く
import "../styles/app.css";
import { markerPoints } from "../lib/markers";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const title = "三体問題シミュレーター";
const description = "天体が重力で引き合う三体問題（N 体問題）を、Rust で数値計算し、WebAssembly でブラウザ上に 3 次元で描きます。天体の数・初期値・積分法・刻み幅を選べ、全エネルギーの誤差やカオスも確かめられます。";
// 天体の形の凡例（初期値の表と同じ形をキャンバスにも描く）
const symbols = Array.from({ length: 8 }, (_, i) => {
  const points = markerPoints(i, 8);
  return points ? { id: `mk${i}`, points: points.map(([x, y]) => `${(10 + x).toFixed(2)},${(10 + y).toFixed(2)}`).join(" ") } : { id: `mk${i}`, points: null };
});
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://inuverse44.github.io/three-body/" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <svg class="sprite" width="0" height="0" aria-hidden="true" focusable="false">
      {symbols.map((s) => <symbol id={s.id} viewBox="0 0 20 20">{s.points ? <polygon points={s.points} fill="currentColor" /> : <circle cx="10" cy="10" r="8" fill="currentColor" />}</symbol>)}
    </svg>
    <a class="skip" href="#main">本文へ移動</a>
    <header class="bar">
      <h1>{title}</h1>
      <a class="icon-btn" href={`${base}/help/`} aria-label="使い方と解説">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M9.6 9.5a2.5 2.5 0 1 1 3.6 2.2c-.8.4-1.2 1-1.2 1.8" /><path d="M12 17h.01" /></svg>
      </a>
    </header>
    <main id="main" data-simulator data-wasm-url={`${base}/sim.wasm`}>
      <div class="stage">
        <figure class="view">
          <canvas id="orbits" width="960" height="840" tabindex="0" role="img" aria-label="天体の軌道の 4 面図。左上が立体図（ドラッグか矢印キーで回転）、右上が xy 平面、左下が xz 平面、右下が yz 平面への投影。天体は色と番号と形で区別する"></canvas>
          <div class="transport" role="toolbar" aria-label="再生と視点">
            <button id="play" class="icon-btn primary" type="button" aria-pressed="false" aria-label="再生" disabled>
              <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
              <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14" /></svg>
            </button>
            <button id="apply" class="icon-btn" type="button" aria-label="初期値からやり直す" disabled>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.5-5.8" /><path d="M4 4v4h4" /></svg>
            </button>
            <span class="gap"></span>
            <button id="zoom-in" class="icon-btn" type="button" aria-label="拡大">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6" /><path d="M20 20l-4.2-4.2M11 8.5v5M8.5 11h5" /></svg>
            </button>
            <button id="zoom-out" class="icon-btn" type="button" aria-label="縮小">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6" /><path d="M20 20l-4.2-4.2M8.5 11h5" /></svg>
            </button>
            <button id="view-reset" class="icon-btn" type="button" aria-label="視点を戻す">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M12 3v4M12 17v4M3 12h4M17 12h4" /></svg>
            </button>
          </div>
        </figure>
        <p data-message role="status"></p>
        <p class="error" data-error hidden>WebAssembly を読み込めませんでした。お使いのブラウザでは動かない可能性があります。</p>

        <details class="block" open>
          <summary>初期値</summary>
          <div class="table-scroll" data-initial>
            <table class="initial">
              <thead><tr><th scope="col"><span class="sr-only">天体</span></th><th scope="col">m</th><th scope="col">x</th><th scope="col">y</th><th scope="col">z</th><th scope="col">v<sub>x</sub></th><th scope="col">v<sub>y</sub></th><th scope="col">v<sub>z</sub></th></tr></thead>
              <tbody></tbody>
            </table>
          </div>
          <div class="row">
            <button id="remove-body" class="icon-btn" type="button" aria-label="天体を減らす"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 12h12" /></svg></button>
            <button id="add-body" class="icon-btn" type="button" aria-label="天体を足す"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 12h12M12 6v12" /></svg></button>
          </div>
        </details>

        <section class="block">
          <h2 class="sr-only">全エネルギーの相対誤差</h2>
          <canvas id="energy" width="960" height="460" role="img" aria-label="時刻ごとの全エネルギーの相対誤差のグラフ。横軸は時刻、縦軸は相対誤差（対数）。比べたときの数値は下の表にもある"></canvas>
          <ul class="legend" data-energy-legend></ul>
          <div class="row">
            <label class="field"><span>t ≤</span><input id="compare-until" type="number" min="0" step="any" value="20" /></label>
            <button id="compare" class="text-btn" type="button" disabled>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 18c4 0 4-12 8-12s4 12 8 12" /></svg>
              3 つの積分法で比べる
            </button>
          </div>
          <table class="compare">
            <thead><tr><th scope="col"><span class="sr-only">積分法</span></th><th scope="col">ε<sub>end</sub></th><th scope="col">ε<sub>max</sub></th><th scope="col">n</th></tr></thead>
            <tbody data-compare-table></tbody>
          </table>
        </section>
      </div>

      <aside class="panel" aria-label="設定">
        <select id="preset" class="wide" aria-label="プリセット">
          <optgroup label="有名な解">
            <option value="0">8 の字の解</option>
            <option value="1">ピタゴラスの三体問題</option>
            <option value="2">8 の字の解＋垂直の速度（3 次元）</option>
            <option value="3">傾いた連星＋第 3 天体（3 次元）</option>
          </optgroup>
          <optgroup label="研究済みの周期解（Šuvakov & Dmitrašinović 2013）">
            <option value="4">蝶 I</option>
            <option value="5">蛾 I</option>
            <option value="6">陰陽 I</option>
            <option value="7">トンボ</option>
          </optgroup>
          <optgroup label="ラグランジュ点とオイラーの解">
            <option value="8">ラグランジュの正三角形の解（等質量）</option>
            <option value="9" data-rotating>太陽・木星・トロヤ群（L4）</option>
            <option value="18" data-rotating data-speed="10" data-trail="Infinity">トロヤ群のオタマジャクシ軌道</option>
            <option value="19" data-rotating data-speed="10" data-trail="Infinity">トロヤ群の馬蹄形軌道</option>
            <option value="10" data-rotating data-speed="10" data-trail="Infinity">重い伴星と L4（不安定）</option>
            <option value="11">オイラーの一直線の解</option>
          </optgroup>
          <optgroup label="惑星">
            <option value="12">Kepler-16（連星を回る惑星）</option>
            <option value="13">Kepler-16 の惑星を内側に置く</option>
            <option value="14">古在・リドフ振動（3 次元）</option>
          </optgroup>
          <optgroup label="連星への侵入">
            <option value="15">入れ替わり</option>
            <option value="16">ばらばら</option>
          </optgroup>
          <optgroup label="3 次元">
            <option value="17">シトニコフ問題</option>
          </optgroup>
          <option value="-1">自分で入力</option>
        </select>

        <dl class="readout">
          <div><dt>t<span class="sr-only">時刻</span></dt><dd data-out="time">—</dd></div>
          <div><dt>n<span class="sr-only">計算の回数</span></dt><dd data-out="steps">—</dd></div>
          <div><dt>h<span class="sr-only">いまの刻み幅</span></dt><dd data-out="dt">—</dd></div>
          <div><dt>ε<span class="sr-only">全エネルギーの相対誤差</span></dt><dd data-out="energy">—</dd></div>
          <div><dt>|ΔL|<span class="sr-only">全角運動量のずれ</span></dt><dd data-out="angular">—</dd></div>
          <div><dt>δ<span class="sr-only">2 つの計算の位置のずれ</span></dt><dd data-out="separation">—</dd></div>
        </dl>

        <div class="group">
          <label class="field icon-field">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 17c3 0 3-10 8-10s5 10 8 10" /></svg>
            <select id="method" aria-label="積分法">
              <option value="1">RK45（刻み幅を自動で変える）</option>
              <option value="0">RK4（刻み幅一定）</option>
              <option value="2">リープフロッグ法（刻み幅一定）</option>
            </select>
          </label>
          <label class="field" data-field="dt"><span>h</span><input id="dt" type="number" inputmode="decimal" min="0" step="any" value="0.01" /></label>
          <label class="field" data-field="tolerance"><span>τ</span><input id="tolerance" type="number" inputmode="decimal" min="0" step="any" value="1e-10" /></label>
        </div>

        <div class="group">
          <label class="field icon-field">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 18c4 0 5-4 8-8s6-3 10-3" /><circle cx="21" cy="7" r="1.5" /></svg>
            <select id="trail" aria-label="軌跡の長さ">
              <option value="0">0（点だけ）</option>
              <option value="0.5">0.5 単位時間</option>
              <option value="1">1 単位時間</option>
              <option value="2" selected>2 単位時間</option>
              <option value="5">5 単位時間</option>
              <option value="10">10 単位時間</option>
              <option value="20">20 単位時間</option>
              <option value="Infinity">∞（すべて残す）</option>
            </select>
          </label>
          <label class="field icon-field">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 6l7 6-7 6zM13 6l7 6-7 6z" /></svg>
            <select id="speed" aria-label="再生の速さ">
              <option value="0.5">0.5 単位時間 / 秒</option>
              <option value="1" selected>1 単位時間 / 秒</option>
              <option value="3">3 単位時間 / 秒</option>
              <option value="10">10 単位時間 / 秒</option>
            </select>
          </label>
        </div>

        <div class="group">
          <label class="switch"><input id="chaos" type="checkbox" /><span class="track" aria-hidden="true"></span>カオス<span class="swatch dashed sm" data-chaos-legend hidden></span></label>
          <div class="fields" data-chaos-fields hidden>
            <label class="field"><span class="sr-only">ずらす天体</span><select id="chaos-body"></select></label>
            <label class="field"><span>Δx</span><input id="chaos-dx" type="number" step="any" value="1e-6" /></label>
            <label class="field"><span>Δy</span><input id="chaos-dy" type="number" step="any" value="0" /></label>
            <label class="field"><span>Δz</span><input id="chaos-dz" type="number" step="any" value="0" /></label>
          </div>
        </div>

        <div class="group">
          <label class="switch"><input id="rotating" type="checkbox" /><span class="track" aria-hidden="true"></span>回転座標系</label>
          <div class="fields" data-rotating-fields hidden>
            <label class="field"><span>主星</span><select id="primary"></select></label>
            <label class="field"><span>伴星</span><select id="secondary"></select></label>
          </div>
        </div>
      </aside>
    </main>
    <script>
      import "../scripts/simulator.ts";
    </script>
  </body>
</html>
